{
  "name": "niak-weather",
  "version": "1.8.0",
  "private": true,
  "description": "A configurable weather dashboard card for Home Assistant",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:station-coverage": "vitest run --coverage --coverage.include=src/station-history.ts --coverage.include=src/station-profiles.ts",
    "test:browser": "npm run build && node scripts/browser-qa.mjs",
    "preview:weather": "npm run build && node scripts/preview-current-weather.mjs",
    "port:local": "node scripts/port-local.mjs",
    "validate": "npm run check && npm run test && npm run build"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "weather-card"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdi/js": "^7.4.47",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "lit": "^3.3.0"
  }
}
